# Salin file ini jadi ".env" lalu isi API key yang kamu punya.
# Provider yang key-nya KOSONG akan otomatis berjalan MODE DEMO.
# Kamu tidak perlu punya semua key — isi yang ada saja.

# --- Chat & rencana video (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- ChatGPT / gambar (OpenAI) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Gemini (Google) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Grok (xAI) ---
XAI_API_KEY=
# XAI_MODEL=grok-4

# Opsional
# PORT=3000
