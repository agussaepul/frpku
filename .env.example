# Salin file ini jadi ".env" lalu isi API key Anthropic kamu.
# Tanpa key, aplikasi tetap jalan dalam MODE DEMO (rencana contoh).

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Opsional: ganti model (default claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Opsional: ganti port (default 3000)
# PORT=3000
